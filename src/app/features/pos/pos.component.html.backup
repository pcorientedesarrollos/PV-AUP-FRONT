    <div class="h-screen flex flex-col bg-slate-50 overflow-hidden">

      <!-- Navbar superior (Estilo Enterprise) -->
      <header class="bg-slate-950 text-white border-b border-slate-800 flex-shrink-0 z-20 shadow-sm">
        <div class="flex items-center justify-between px-4 md:px-6 h-16 gap-2">
          
          <!-- Logo + título -->
          <div class="flex items-center gap-3">
            <button (click)="navegar('/home')" class="text-amber-500 hover:text-amber-400 transition-colors mr-2 hidden md:block focus:outline-none focus:text-amber-400" title="Volver al Dashboard">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
            <div class="hidden sm:flex items-center" [title]="auth.sesion()?.empresa?.nombre || 'AUP POS'">
              <img [src]="auth.sesion()?.empresa?.logoUrl || '/logo.png'" [alt]="auth.sesion()?.empresa?.nombre || 'AUP POS'" class="h-8 object-contain drop-shadow-[0_2px_4px_rgba(245,158,11,0.3)]" />
            </div>
            <div class="hidden sm:block border-l border-slate-700 pl-3 ml-1">
              <p class="text-white font-bold text-sm tracking-tight leading-none">Punto de Venta</p>
              <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest mt-0.5">{{ auth.sesion()?.sucursalNombre || 'Terminal 01' }}</p>
            </div>
          </div>

          <!-- Total en mobile (siempre visible) -->
          <div class="sm:hidden flex items-center gap-1 bg-amber-500/10 border border-amber-500/20 rounded px-3 py-1.5 shadow-sm">
            <span class="text-amber-500 text-sm font-bold">
              🛒 {{ pos.totalPagar() | currency }}
            </span>
          </div>

          <!-- Info del usuario + Carrito Toggle + Logout -->
          <div class="flex items-center gap-2 md:gap-4">
            <div class="hidden md:flex items-center gap-2">
              <div class="text-right">
                <p class="text-xs font-bold text-white">{{ auth.usuario() }}</p>
                <p class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest">Caja Abierta</p>
              </div>
              <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-amber-500 font-bold text-sm border border-slate-700">
                {{ auth.usuario().charAt(0).toUpperCase() }}
              </div>
            </div>

            <!-- Botón toggle carrito en mobile -->
            <button
              id="btn-toggle-carrito"
              (click)="carritoVisible.set(!carritoVisible())"
              class="md:hidden relative bg-slate-800 border border-slate-700 text-white rounded p-2 hover:bg-slate-700 transition-all focus:outline-none focus:ring-2 focus:ring-amber-500"
            >
              🛒
              @if (pos.totalItems() > 0) {
                <span class="absolute -top-1.5 -right-1.5 bg-rose-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center shadow-sm">
                  {{ pos.totalItems() }}
                </span>
              }
            </button>

            <button
              id="btn-corte"
              (click)="abrirCorteCaja()"
              class="hidden sm:flex text-emerald-400 hover:text-white bg-slate-800 hover:bg-emerald-600 border border-slate-700 hover:border-emerald-500 rounded px-3 py-1.5 text-xs font-medium transition-all items-center gap-1 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span>Corte</span>
            </button>

            <div class="w-px h-6 bg-slate-700 hidden md:block mx-1"></div>

            <button
              id="btn-logout"
              (click)="logout()"
              class="text-rose-400 hover:text-white bg-slate-800 hover:bg-rose-500 border border-slate-700 hover:border-rose-500 rounded px-3 py-1.5 text-xs font-medium transition-all flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-rose-500"
            >
              <span class="hidden sm:inline">Salir</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </button>
          </div>
        </div>
      </header>

      <!-- Layout principal -->
      <div class="flex-1 flex overflow-hidden relative">

        <!-- Catálogo (izquierda / pantalla completa en mobile) -->
        <main
          class="flex-1 flex flex-col overflow-hidden transition-all duration-300"
          [class.hidden]="carritoVisible() && isMobile()"
        >
          <app-catalogo class="flex flex-col h-full" />
        </main>

        <!-- Carrito (sidebar derecho / overlay en mobile) -->
        <aside
          class="flex flex-col overflow-hidden transition-all duration-300 border-l border-slate-200 bg-white shadow-[-4px_0_15px_-3px_rgba(0,0,0,0.05)] flex-shrink-0"
          [class.w-0]="!carritoVisible() && isMobile()"
          [class.w-full]="carritoVisible() && isMobile()"
          [class.hidden]="!carritoVisible() && isMobile()"
          [class.w-96]="!isMobile()"
          [class.xl:w-[400px]]="!isMobile()"
        >
          <app-carrito
            class="flex flex-col h-full"
            (nuevoCliente)="mostrarNuevoCliente.set(true)"
            #carritoRef
          />
        </aside>
      </div>

      <!-- Modal: Apertura de caja (obligatorio al inicio) -->
      @if (!turnoAbierto()) {
        <app-apertura-caja />
      }

      <!-- Modal: Alta rápida de cliente -->
      @if (mostrarNuevoCliente()) {
        <app-cliente-rapido
          (cerrar)="mostrarNuevoCliente.set(false)"
          (clienteCreado)="onClienteCreado($event)"
        />
      }

      <!-- Modal: Advertencia de Stock -->
      @if (pos.productoAdvertenciaStock() !== null) {
        <div class="modal-backdrop">
          <div class="modal-panel flex flex-col slideInDown">
            <!-- Header -->
            <div class="modal-header bg-amber-50 border-amber-100 flex items-center gap-3">
              <div class="bg-amber-100 text-amber-600 p-2 rounded-full">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              </div>
              <h3 class="modal-title text-amber-900">
                {{ pos.productoAdvertenciaStock()?.tipo === 'vacio' ? '¡Sin Stock Disponible!' : '¡Límite de Stock Superado!' }}
              </h3>
            </div>

            <!-- Body -->
            <div class="modal-body space-y-4">
              @if (pos.productoAdvertenciaStock()?.tipo === 'vacio') {
                <p>El producto <span class="font-bold text-slate-900">"{{ pos.productoAdvertenciaStock()?.producto?.nombre }}"</span> tiene un inventario de cero o menor.</p>
              } @else {
                <p>Estás agregando más unidades de <span class="font-bold text-slate-900">"{{ pos.productoAdvertenciaStock()?.producto?.nombre }}"</span> que las que hay disponibles en stock.</p>
              }
              <p class="mt-2">¿Estás seguro de que deseas agregarlo al carrito y venderlo de todas formas?</p>
            </div>

            <!-- Footer / Botones -->
            <div class="modal-footer">
              <button 
                (click)="pos.cancelarVentaSinStock()"
                class="btn-secondary"
              >
                Cancelar
              </button>
              <button 
                (click)="pos.confirmarVentaSinStock()"
                class="btn-primary"
              >
                Sí, venderlo
              </button>
            </div>
          </div>
        </div>
      }

      <!-- Modal: Corte de Caja -->
      @if (mostrarCorteCaja()) {
        <div class="modal-backdrop">
          <div class="modal-panel flex flex-col bg-slate-900 border border-slate-800 slideInDown">
            <div class="modal-header bg-slate-900 border-slate-800">
              <h3 class="modal-title text-white">Corte de Caja</h3>
              <button (click)="cerrarCorteCaja()" class="text-slate-400 hover:text-rose-400 transition-colors focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
            <div class="modal-body space-y-4 text-white">
              @if (datosCorte()) {
                <div class="bg-slate-950 p-4 rounded-lg border border-slate-800 mb-4">
                  <p class="text-xs text-slate-400 uppercase tracking-widest font-bold">Fondo Inicial / Apertura</p>
                  <p class="text-xl font-bold text-slate-200 mt-1">
                    {{ datosCorte().resumen.aperturasCaja | currency }}
                  </p>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-4">
                  <div class="bg-slate-800 p-4 rounded border border-slate-700">
                    <p class="text-xs text-emerald-400 font-bold mb-1">Efectivo (+Apertura)</p>
                    <p class="text-xl font-bold text-white">{{ datosCorte().resumen.totalEfectivo | currency }}</p>
                  </div>
                  <div class="bg-slate-800 p-4 rounded border border-slate-700">
                    <p class="text-xs text-blue-400 font-bold mb-1">Tarjetas</p>
                    <p class="text-xl font-bold text-white">{{ datosCorte().resumen.totalTarjeta | currency }}</p>
                  </div>
                  <div class="bg-slate-800 p-4 rounded border border-slate-700">
                    <p class="text-xs text-indigo-400 font-bold mb-1">Transferencias</p>
                    <p class="text-xl font-bold text-white">{{ datosCorte().resumen.totalTransferencia | currency }}</p>
                  </div>
                  <div class="bg-slate-800 p-4 rounded border border-slate-700">
                    <p class="text-xs text-rose-400 font-bold mb-1">Devoluciones</p>
                    <p class="text-xl font-bold text-white">{{ datosCorte().resumen.totalCancelado | currency }}</p>
                  </div>
                </div>
                <div class="bg-slate-950 p-4 rounded-lg border border-amber-500/30 text-center">
                  <p class="text-sm font-bold text-amber-500 uppercase">Ingresos Globales</p>
                  <p class="text-3xl font-black text-amber-400">{{ datosCorte().resumen.totalIngresos | currency }}</p>
                </div>
              } @else {
                <div class="text-center text-slate-400 py-6">
                  Cargando resumen...
                </div>
              }
            </div>
            <div class="modal-footer bg-slate-900 border-slate-800">
              <button class="btn-secondary bg-slate-800 text-white border-slate-700 hover:bg-slate-700 w-full" (click)="cerrarCorteCaja()">Cerrar</button>
            </div>
          </div>
        </div>
      }
    </div>
