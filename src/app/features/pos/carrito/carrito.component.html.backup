<div class="flex flex-col h-full bg-slate-900 text-white print:hidden">

      <!-- Header del carrito -->
      <div class="bg-slate-950 border-b border-slate-800 px-4 py-3 sm:px-5 sm:py-4 flex flex-wrap items-center justify-between gap-2 flex-shrink-0">
        <div class="flex items-center gap-2 flex-wrap">
          <svg class="w-5 h-5 text-amber-500 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <span class="text-white font-bold text-sm sm:text-base">Carrito Actual</span>
          @if (pos.totalItems() > 0) {
            <span class="bg-amber-500/20 text-amber-400 font-bold text-xs px-2 py-0.5 rounded border border-amber-500/30 ml-1 shadow-sm">
              {{ pos.totalItems() }} items
            </span>
          }
          @if (pos.ventasPausadas().length > 0) {
            <button
              (click)="abrirModalPausadas()"
              class="ml-2 bg-indigo-500/20 text-indigo-400 font-bold text-xs px-2 py-0.5 rounded border border-indigo-500/30 shadow-sm hover:bg-indigo-500/40 transition-colors flex items-center gap-1"
            >
              ⏸️ {{ pos.ventasPausadas().length }} en espera
            </button>
          }
        </div>
        <div class="flex items-center gap-3">
          @if (pos.carrito().length > 0) {
            <button
              (click)="pausarVentaActual()"
              class="text-indigo-400 hover:text-indigo-300 text-xs font-medium uppercase tracking-widest transition-colors flex items-center gap-1 focus:outline-none"
            >
              Pausar
            </button>
            <button
              id="btn-limpiar-carrito"
            (click)="limpiarCarrito()"
            class="text-slate-400 hover:text-rose-400 text-xs font-medium uppercase tracking-widest transition-colors flex items-center gap-1 focus:outline-none focus:text-rose-400"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            Limpiar
          </button>
        }
        </div>
      </div>

      <!-- Lista de items -->
      <div class="flex-1 overflow-y-auto divide-y divide-slate-800 custom-scrollbar">
        @if (pos.carrito().length === 0) {
          <div class="flex flex-col items-center justify-center h-full text-slate-500 space-y-3 p-4">
            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <p class="text-sm text-center font-medium text-slate-400">Selecciona productos<br>del catálogo</p>
          </div>
        } @else {
          @for (item of pos.carrito(); track item.producto.idProducto) {
            <div class="px-5 py-4 flex gap-3 items-center hover:bg-slate-800 transition-colors group">
              <!-- Info producto -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <p class="text-sm font-medium text-white leading-tight truncate group-hover:text-amber-400 transition-colors">{{ item.producto.nombre }}</p>
                  @if (pos.stockActual()[item.producto.idProducto] <= 5) {
                    <span class="text-amber-500" title="¡Inventario Bajo! ({{ pos.stockActual()[item.producto.idProducto] }} restantes)">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    </span>
                  }
                </div>
                <div class="flex items-center gap-2 mt-1">
                  <p class="text-[10px] text-slate-400 font-medium uppercase tracking-widest">{{ item.producto.codigoBarras || item.producto.idProducto || 'S/N' }}</p>
                  <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                  <p class="text-xs text-emerald-400 font-bold">
                    {{ item.subtotal | currency }}
                  </p>
                </div>
              </div>

              <!-- Controles de cantidad -->
              <div class="flex items-center gap-1 flex-shrink-0 bg-slate-950 border border-slate-700 rounded-lg shadow-sm overflow-hidden p-1">
                <button
                  (click)="pos.cambiarCantidad(item.producto.idProducto, -1)"
                  class="w-10 h-10 rounded bg-slate-800 text-white font-bold text-lg hover:bg-rose-500 hover:text-white active:scale-95 transition-all flex items-center justify-center focus:outline-none flex-shrink-0"
                >−</button>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  [ngModel]="item.cantidad"
                  (ngModelChange)="pos.setCantidadExacta(item.producto.idProducto, $event)"
                  class="w-14 text-center text-base font-black text-white bg-transparent border-none focus:ring-0 p-0 m-0 hide-arrows"
                />
                <button
                  (click)="pos.cambiarCantidad(item.producto.idProducto, 1)"
                  class="w-10 h-10 rounded bg-slate-800 text-white font-bold text-lg hover:bg-emerald-500 hover:text-white active:scale-95 transition-all flex items-center justify-center focus:outline-none flex-shrink-0"
                >+</button>
              </div>
            </div>
          }
        }
      </div>

      <!-- Panel inferior: cliente + cobro -->
      <div class="flex-shrink-0 p-5 bg-slate-950 border-t border-slate-800 shadow-[0_-10px_20px_-10px_rgba(0,0,0,0.5)]">

        <!-- Selector de cliente -->
        <div class="space-y-1.5 mb-5">
          <div class="flex justify-between items-center">
            <label class="text-[10px] font-medium text-slate-400 uppercase tracking-widest">Asignar Cliente</label>
            <button
              id="btn-nuevo-cliente"
              (click)="nuevoCliente.emit()"
              class="text-[10px] font-bold uppercase tracking-widest text-amber-500 hover:text-amber-400 transition-colors flex items-center gap-1 focus:outline-none"
            >
              <span>+</span> Nuevo
            </button>
          </div>
          <div class="relative">
            <!-- Dropdown Trigger -->
            <button
              (click)="toggleDropdown()"
              type="button"
              class="w-full px-3 py-2.5 bg-slate-900 border border-slate-700 rounded text-sm font-medium text-white flex items-center justify-between shadow-sm hover:border-slate-600 focus:outline-none focus:ring-1 focus:ring-amber-500 transition-all text-left"
            >
              <span class="truncate">{{ nombreClienteSeleccionado() }}</span>
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" [class.rotate-180]="dropdownAbierto()"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <!-- Dropdown Menu -->
            @if (dropdownAbierto()) {
              <!-- Backdrop para cerrar al hacer clic afuera -->
              <div class="fixed inset-0 z-40" (click)="dropdownAbierto.set(false)"></div>
              
              <!-- Menú (Flota hacia arriba) -->
              <div class="absolute bottom-full left-0 w-full mb-2 bg-slate-800 border border-slate-700 rounded-lg shadow-2xl z-50 overflow-hidden flex flex-col">
                <!-- Buscador interno -->
                <div class="p-2 border-b border-slate-700 bg-slate-800/95 backdrop-blur-sm">
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
                      <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input
                      type="text"
                      [ngModel]="busquedaCliente()"
                      (ngModelChange)="busquedaCliente.set($event)"
                      placeholder="Buscar cliente..."
                      class="w-full pl-9 pr-3 py-2 bg-slate-900 border border-slate-700 rounded-md text-sm text-white focus:outline-none focus:border-amber-500 placeholder:text-slate-500"
                    />
                  </div>
                </div>
                
                <!-- Lista de opciones -->
                <ul class="max-h-56 overflow-y-auto custom-scrollbar py-1">
                  <li>
                    <button
                      type="button"
                      (click)="seleccionarClienteDropdown('')"
                      class="w-full text-left px-4 py-2 text-sm font-medium text-amber-500 hover:bg-slate-700 hover:text-amber-400 transition-colors border-b border-slate-700/50"
                    >
                      — Público General —
                    </button>
                  </li>
                  @for (cliente of clientesFiltrados(); track cliente.idCliente) {
                    <li>
                      <button
                        type="button"
                        (click)="seleccionarClienteDropdown(cliente.idCliente.toString())"
                        class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
                      >
                        {{ cliente.nombreCompleto }}
                      </button>
                    </li>
                  }
                  @if (clientesFiltrados().length === 0) {
                    <li class="px-4 py-4 text-center text-sm text-slate-500">
                      No se encontraron clientes.
                    </li>
                  }
                </ul>
              </div>
            }
          </div>
        </div>

        <!-- Total y Botón en la misma caja visual -->
        <div class="bg-slate-900 border border-slate-700 rounded-lg shadow-sm p-4 space-y-3">
          
          <div class="flex justify-between items-center text-sm font-medium text-slate-400">
            <span>Subtotal</span>
            <span>{{ pos.totalPagar() | currency }}</span>
          </div>

          <div class="flex justify-between items-center text-sm font-medium">
            <button (click)="abrirModalDescuento()" class="text-amber-500 hover:text-amber-400 underline decoration-dashed underline-offset-4 focus:outline-none flex items-center gap-1">
              <span>Descuento {{ tipoDescuento() === 'porcentaje' && valorDescuento() > 0 ? '(' + valorDescuento() + '%)' : '' }}</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
            </button>
            <span class="text-rose-400">-{{ descuentoGlobal() | currency }}</span>
          </div>

          <div class="pt-2 border-t border-slate-800 flex justify-between items-end">
            <span class="text-sm font-medium text-slate-400">Total a pagar</span>
            <span class="text-3xl font-bold text-emerald-400 tracking-tight">
              {{ totalPagarFinal() | currency }}
            </span>
          </div>

          <button
            id="btn-cobrar"
            (click)="cobrar()"
            [disabled]="pos.carrito().length === 0 || cargando()"
            class="w-full py-3.5 bg-emerald-600 text-white font-medium rounded-md shadow hover:bg-emerald-500 active:scale-95 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 focus:ring-offset-slate-900"
          >
            @if (cargando()) {
              <svg class="animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
              </svg>
              <span>Procesando...</span>
            } @else {
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
              <span>Cobrar Venta (F12)</span>
            }
          </button>
        </div>
      </div>
    </div>

    <!-- Modal de Pago y Cambio -->
    @if (modalPagoAbierto()) {
      <div class="modal-backdrop print:hidden">
        <div class="modal-panel modal-panel-sm flex flex-col bg-slate-900 border border-slate-800">
          <div class="modal-header bg-slate-900 border-slate-800">
            <h3 class="modal-title text-white">Completar Pago</h3>
            <button (click)="cerrarModalPago()" class="text-slate-400 hover:text-rose-400 transition-colors focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>

          <div class="modal-body">
          <div class="text-center bg-slate-950 rounded-lg py-4 border border-slate-800 mb-6 shadow-inner">
            <p class="text-sm font-medium text-slate-400 uppercase tracking-widest mb-1">Total a cobrar</p>
            <p class="text-4xl font-black text-amber-500">{{ totalPagarFinal() | currency }}</p>
          </div>

          <!-- Metodo de Pago -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-slate-400 mb-3">Método de Pago</label>
            <div class="grid grid-cols-3 gap-3">
              <button
                (click)="metodoPago.set('Efectivo')"
                [class.bg-emerald-600]="metodoPago() === 'Efectivo'"
                [class.text-white]="metodoPago() === 'Efectivo'"
                [class.border-emerald-500]="metodoPago() === 'Efectivo'"
                [class.bg-slate-800]="metodoPago() !== 'Efectivo'"
                [class.text-slate-400]="metodoPago() !== 'Efectivo'"
                [class.border-slate-700]="metodoPago() !== 'Efectivo'"
                class="py-3 px-2 rounded border font-medium text-sm flex flex-col items-center gap-1 transition-all focus:outline-none"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                Efectivo
              </button>
              <button
                (click)="metodoPago.set('Tarjeta')"
                [class.bg-emerald-600]="metodoPago() === 'Tarjeta'"
                [class.text-white]="metodoPago() === 'Tarjeta'"
                [class.border-emerald-500]="metodoPago() === 'Tarjeta'"
                [class.bg-slate-800]="metodoPago() !== 'Tarjeta'"
                [class.text-slate-400]="metodoPago() !== 'Tarjeta'"
                [class.border-slate-700]="metodoPago() !== 'Tarjeta'"
                class="py-3 px-2 rounded border font-medium text-sm flex flex-col items-center gap-1 transition-all focus:outline-none"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                Tarjeta
              </button>
              <button
                (click)="metodoPago.set('Transferencia')"
                [class.bg-emerald-600]="metodoPago() === 'Transferencia'"
                [class.text-white]="metodoPago() === 'Transferencia'"
                [class.border-emerald-500]="metodoPago() === 'Transferencia'"
                [class.bg-slate-800]="metodoPago() !== 'Transferencia'"
                [class.text-slate-400]="metodoPago() !== 'Transferencia'"
                [class.border-slate-700]="metodoPago() !== 'Transferencia'"
                class="py-3 px-2 rounded border font-medium text-sm flex flex-col items-center gap-1 transition-all focus:outline-none"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                Transf.
              </button>
            </div>
          </div>

          <!-- Entrada de Efectivo y Cambio -->
          @if (metodoPago() === 'Efectivo') {
            <div class="mb-6 space-y-4">
              <div>
                <label class="block text-sm font-medium text-slate-400 mb-1.5">Efectivo Recibido</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="text-slate-400 font-bold">$</span>
                  </div>
                  <input
                    type="number"
                    [ngModel]="cantidadRecibida()"
                    (ngModelChange)="cantidadRecibida.set($event)"
                    placeholder="0.00"
                    class="w-full pl-8 pr-4 py-3 bg-slate-950 border border-slate-700 rounded-lg text-xl font-bold text-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 shadow-sm transition-all text-right"
                    autocomplete="off"
                  />
                </div>
              </div>

              <!-- Atajos de billetes -->
              <div class="flex gap-2">
                @for (monto of [100, 200, 500, 1000]; track monto) {
                  <button (click)="cantidadRecibida.set(monto)" class="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 rounded text-sm font-bold transition-colors">
                    ${{ monto }}
                  </button>
                }
              </div>

              <button (click)="cantidadRecibida.set(totalPagarFinal())" class="w-full mt-2 py-2 bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600/30 border border-emerald-500/30 rounded text-sm font-bold uppercase tracking-widest transition-colors flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Cobro Exacto
              </button>

              <div class="flex justify-between items-center p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-lg mt-4">
                <span class="text-sm font-bold text-emerald-500">Cambio a devolver:</span>
                <span class="text-2xl font-black text-emerald-400">{{ cambio() | currency }}</span>
              </div>
            </div>
          }

            <button
              (click)="confirmarCobro()"
              [disabled]="cargando()"
              class="w-full py-4 btn-primary bg-emerald-600 hover:bg-emerald-500 focus:ring-emerald-500 text-lg rounded-lg shadow-lg flex items-center justify-center gap-2"
            >
              @if (cargando()) {
                <svg class="animate-spin w-5 h-5" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
                </svg>
                <span>Procesando...</span>
              } @else {
                <span>Confirmar Pago</span>
              }
            </button>
          </div>
        </div>
      </div>
    }

    <!-- Modal de confirmación de éxito (Enterprise) -->
    @if (ventaExitosa()) {
      <div class="modal-backdrop print:hidden">
        <div class="modal-panel modal-panel-sm flex flex-col bg-slate-900 border border-slate-800 text-center">
          <div class="modal-body space-y-6">
            <div class="mx-auto w-20 h-20 bg-emerald-500/10 rounded-full flex items-center justify-center mb-2">
              <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            
            <div>
              <h3 class="text-xl font-bold text-white">¡Venta Registrada!</h3>
              <p class="text-slate-400 text-sm mt-1">La transacción se procesó correctamente.</p>
            </div>
            
            <div class="bg-slate-950 rounded p-4 border border-slate-800">
             <p class="text-xs font-medium text-slate-500 uppercase tracking-widest mb-1">Total Cobrado</p>
             <p class="text-2xl font-bold text-emerald-400">{{ ultimoTotal() | currency }}</p>
          </div>
          
            <div class="grid grid-cols-2 gap-3 mt-4">
              <button
                (click)="imprimirTicket()"
                class="w-full btn-secondary bg-slate-800 hover:bg-slate-700 text-white border-slate-700 focus:ring-slate-700 flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                Imprimir Ticket
              </button>
              <button
                id="btn-nueva-venta"
                (click)="nuevaVenta()"
                class="w-full btn-primary flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                Nueva Venta
              </button>
            </div>
          </div>
        </div>
      </div>
    }
    <!-- Modal Descuento -->
    @if (modalDescuentoAbierto()) {
      <div class="modal-backdrop print:hidden">
        <div class="modal-panel modal-panel-sm flex flex-col bg-slate-900 border border-slate-800">
          <div class="modal-header bg-slate-900 border-slate-800">
            <h3 class="modal-title text-white">Aplicar Descuento</h3>
            <button (click)="cerrarModalDescuento()" class="text-slate-400 hover:text-rose-400 transition-colors focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
          <div class="modal-body space-y-4">
            <div class="flex gap-2 mb-2">
              <button 
                (click)="inputTipoDescuento.set('cantidad')" 
                [class.bg-emerald-600]="inputTipoDescuento() === 'cantidad'" 
                [class.text-white]="inputTipoDescuento() === 'cantidad'"
                [class.bg-slate-800]="inputTipoDescuento() !== 'cantidad'"
                [class.text-slate-400]="inputTipoDescuento() !== 'cantidad'"
                class="flex-1 py-2 rounded border border-slate-700 text-sm font-medium transition-colors focus:outline-none focus:ring-1 focus:ring-emerald-500">
                Monto Fijo ($)
              </button>
              <button 
                (click)="inputTipoDescuento.set('porcentaje')" 
                [class.bg-emerald-600]="inputTipoDescuento() === 'porcentaje'" 
                [class.text-white]="inputTipoDescuento() === 'porcentaje'"
                [class.bg-slate-800]="inputTipoDescuento() !== 'porcentaje'"
                [class.text-slate-400]="inputTipoDescuento() !== 'porcentaje'"
                class="flex-1 py-2 rounded border border-slate-700 text-sm font-medium transition-colors focus:outline-none focus:ring-1 focus:ring-emerald-500">
                Porcentaje (%)
              </button>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-400 mb-1.5">
                {{ inputTipoDescuento() === 'porcentaje' ? 'Porcentaje de Descuento (%)' : 'Monto de Descuento ($)' }}
              </label>
              <input
                type="number"
                [ngModel]="inputDescuento()"
                (ngModelChange)="inputDescuento.set($event)"
                class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-md text-white focus:outline-none focus:border-amber-500"
              />
            </div>
            <button (click)="aplicarDescuento()" class="w-full btn-primary">Aplicar Descuento</button>
          </div>
        </div>
      </div>
    }

    <!-- Modal Ventas Pausadas -->
    @if (modalPausadasAbierto()) {
      <div class="modal-backdrop print:hidden">
        <div class="modal-panel flex flex-col bg-slate-900 border border-slate-800">
          <div class="modal-header bg-slate-900 border-slate-800">
            <h3 class="modal-title text-white">Ventas en Espera</h3>
            <button (click)="cerrarModalPausadas()" class="text-slate-400 hover:text-rose-400 transition-colors focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
          <div class="modal-body max-h-[60vh] overflow-y-auto custom-scrollbar">
            @if (pos.ventasPausadas().length === 0) {
              <p class="text-center text-slate-500 py-4">No hay ventas en espera.</p>
            } @else {
              <ul class="space-y-3">
                @for (vp of pos.ventasPausadas(); track vp.id) {
                  <li class="bg-slate-800 p-4 rounded-lg border border-slate-700 flex justify-between items-center gap-4">
                    <div>
                      <p class="text-sm font-bold text-white">{{ vp.cliente?.nombreCompleto || 'PÚBLICO GENERAL' }}</p>
                      <p class="text-xs text-slate-400">{{ vp.carrito.length }} items | {{ vp.timestamp | date:'shortTime' }}</p>
                    </div>
                    <div class="flex gap-2">
                      <button (click)="eliminarVentaPausada(vp.id)" class="px-3 py-1.5 rounded bg-rose-500/10 text-rose-400 hover:bg-rose-500 hover:text-white transition-colors text-sm font-medium">Descartar</button>
                      <button (click)="recuperarVentaPausada(vp.id)" class="px-3 py-1.5 rounded bg-indigo-600 hover:bg-indigo-500 text-white transition-colors text-sm font-medium">Recuperar</button>
                    </div>
                  </li>
                }
              </ul>
            }
          </div>
        </div>
      </div>
    }
